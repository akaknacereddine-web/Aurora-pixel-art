{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user account profile isolated per authenticated UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 160
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "email", "createdAt", "updatedAt"]
    },
    "PixelProject": {
      "title": "PixelProject",
      "description": "A pixel art canvas or frame-by-frame animation video project owned by a user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "type": {
          "type": "string",
          "enum": ["canvas", "video"]
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "activeFrameIndex": {
          "type": "integer"
        },
        "activeLayerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "onionSkin": {
          "type": "object"
        },
        "palette": {
          "type": "array"
        },
        "customBrushes": {
          "type": "array"
        },
        "frames": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerId",
        "name",
        "type",
        "width",
        "height",
        "activeFrameIndex",
        "activeLayerId",
        "onionSkin",
        "palette",
        "customBrushes",
        "frames",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Authenticated user profile document containing private email and display name."
    },
    "/users/{userId}/projects/{projectId}": {
      "schema": { "$ref": "#/entities/PixelProject" },
      "description": "User-owned pixel art canvases and animation video projects."
    }
  }
}
